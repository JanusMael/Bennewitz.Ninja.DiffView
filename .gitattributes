# Normalize line endings to LF in the repository; tools that need CRLF get it on checkout.
* text=auto eol=lf

*.cs      text
*.axaml   text
*.xaml    text
*.csproj  text
*.props   text
*.targets text
*.slnx    text
*.json    text
*.md      text
*.yml     text
*.sh      text eol=lf
*.ps1     text eol=lf

# Fixtures are compared byte-for-byte, including their line endings — never normalize them.
fixtures/** -text

*.png          binary
*.verified.png binary
*.ttf          binary
*.otf          binary
