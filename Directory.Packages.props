<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Avalonia">
    <PackageVersion Include="Avalonia" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Themes.Simple" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.2" />
    <!-- Runtime XAML loading, which the base Avalonia package deliberately leaves out because it
         carries the XAML compiler. Test-only: plan 00019's quickstart gate loads the snippet from
         docs/hosting-diffview.md rather than a retyped copy, so the markup a reader pastes is the
         markup under test. Nothing shipped references it. -->
    <PackageVersion Include="Avalonia.Markup.Xaml.Loader" Version="12.1.2" />
    <PackageVersion Include="Semi.Avalonia" Version="12.1.0.1" />
  </ItemGroup>

  <ItemGroup Label="Editor and diff">
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageVersion Include="AvaloniaEdit.TextMate" Version="12.0.0" />
    <PackageVersion Include="DiffPlex" Version="1.9.0" />
  </ItemGroup>

  <ItemGroup Label="Logging and diagnostics">
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <!-- From the local feed (../nuget-local), packed from ClaudeForge by scripts/pack-diagnostics.* -->
    <PackageVersion Include="LayeredEditors.Avalonia.Diagnostics" Version="1.0.1" />
  </ItemGroup>

  <ItemGroup Label="Tooling">
    <PackageVersion Include="Bennewitz.Ninja.AutoVersioning" Version="2026.3.916" />
    <!-- The theme and contrast analysis this repository's audit runs on. It used to be
         src/ThemeAudit here; it now lives in Bennewitz.Ninja.XamlQuality, which is where it is
         developed and tested. Test-only: ReferenceAuditTests and ThemeResolutionTests read it,
         nothing shipped does. The `theme-audit` command itself is the sibling package
         Bennewitz.Ninja.XamlQuality.ThemeAudit, installed as a dotnet tool — see README.md. -->
    <!-- Moved together by plan 00028, which re-read every rule of both at the new pins: each release
         renamed every rule id (XQ100n became BNXQ100n, AQ100n became BNAQ100n) and changed what a rule
         counts as inspected, so a rule's reading here is a measurement against these versions and a
         move re-opens it. 928 rather than the plan's 925: AssemblyQuality 928 reports a type it cannot
         load as Skipped instead of throwing, and XamlQuality 928 is 925 with three opt-in rules nothing
         here adopts. -->
    <PackageVersion Include="Bennewitz.Ninja.XamlQuality" Version="2026.3.928" />
    <PackageVersion Include="Bennewitz.Ninja.AssemblyQuality" Version="2026.3.928" />
    <!-- Unicode's East Asian Width, for scripts/measure-menu-width.cs: a CJK glyph takes two columns,
         and .NET carries no such table. Script-only: nothing the solution builds references it. -->
    <PackageVersion Include="Wcwidth" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <!-- Pinned to the xunit.v3.extensibility.core line Avalonia.Headless.XUnit 12.1.2 is built
         against (3.2.2); on 4.0 its test-framework discoverer never hooks in and every
         [AvaloniaFact] runs as a plain test without an Application. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <!-- Same Microsoft.Testing.Platform line as xunit.v3 3.2.2 (1.9.1); a newer TrxReport pins the
         platform above what xunit's bundled MSBuild extension can load. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="1.9.1" />
    <PackageVersion Include="Verify.XunitV3" Version="32.0.0" />
  </ItemGroup>
</Project>
