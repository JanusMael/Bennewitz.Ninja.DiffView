  // The harness's own proof: every test in MutateBehaviourTests killed by a mutation of the reading
  // it guards.
  //
  // ⛔ Run it with --parallel or from a COPY of the harness, never from scripts/mutate-behaviour.cs
  // itself, which refuses: every test it judges runs `dotnet run scripts/mutate-behaviour.cs`, which
  // rebuilds that file's own cached build — the one a harness started from that path is running from,
  // and which Windows holds locked. Each inner build would fail, every test would go red, and every
  // mutation would read as killed. --parallel's shards run from the binary that started them.
  //
  //   dotnet run scripts/mutate-behaviour.cs -- --parallel 4 --set tests/DiffView.Avalonia.Tests/Mutations/mutate-behaviour.json
  //   or copy scripts/mutate-behaviour.cs to a directory outside the repository, then from the root:
  //   dotnet run <copy>/mutate-behaviour.cs -- --set tests/DiffView.Avalonia.Tests/Mutations/mutate-behaviour.json
  "project": "tests/DiffView.Avalonia.Tests/DiffView.Avalonia.Tests.csproj",
  "class": "Bennewitz.Ninja.DiffView.Tests.MutateBehaviourTests",
  "tests": ["tests/DiffView.Avalonia.Tests/MutateBehaviourTests.cs"],
  "mutations": [
