<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Follows the library it tests rather than the repository convention. Leaving these at
         Bennewitz.Ninja.DiffView.Avalonia.Tests would keep Bennewitz.Ninja.DiffView.Avalonia in
         existence as a test-only namespace, and every test file would go on shadowing the
         framework's Avalonia root — the thing plan 00017 exists to remove. -->
    <RootNamespace>Bennewitz.Ninja.DiffView.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <!-- HostingGuideTests loads the guide's quickstart at runtime; see Directory.Packages.props. -->
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Themes.Simple" />
    <!-- The audit's scanners read the token and theme files ThemeResolutionTests checks at runtime,
         and ReferenceAuditTests runs the whole audit over the reference checkouts. This was
         src/ThemeAudit in this repository until the analysis moved to Bennewitz.Ninja.XamlQuality;
         a package reference keeps the audit without keeping a second copy of the analysis, or a
         second project claiming the `theme-audit` tool command. -->
    <PackageReference Include="Bennewitz.Ninja.XamlQuality" />
    <PackageReference Include="Bennewitz.Ninja.AssemblyQuality" />
    <PackageReference Include="Semi.Avalonia" />
    <PackageReference Include="Verify.XunitV3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/DiffView.Avalonia/DiffView.Avalonia.csproj" />
    <ProjectReference Include="../../src/DiffView.Demo/DiffView.Demo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled monospace font so rendered snapshots never depend on the machine's fonts. -->
    <AvaloniaResource Include="../../fixtures/fonts/DejaVuSansMono.ttf" Link="Fonts/DejaVuSansMono.ttf" />
    <!-- Serial execution: every Avalonia test shares the one headless dispatcher. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Reference-dependent tests read the checkouts under reference/. Fetch whatever is missing
       before this project builds, so `dotnet test` on a fresh clone self-heals. The script is a
       no-op when everything is present. Skip with -p:SkipReferenceSources=true. -->
  <Target Name="EnsureReferenceSources" BeforeTargets="Build" Condition="'$(SkipReferenceSources)' != 'true'">
    <Exec Command="dotnet run &quot;$(RepoRoot)scripts/fetch-reference.cs&quot; -- --quiet" WorkingDirectory="$(RepoRoot)" />
  </Target>
</Project>
