{
  // The start-up plan 00034 names in no step, built ahead of step 9 on Brian's word of 2026-10-29: the
  // command line, the plan it reads, what is said before the window opens, the window opened on it, and
  // the line under the panes that says what the durable store knows about the section at the right
  // pane's caret. Every test in the two files is held to it: a full run fails while any is killed by none.
  //
  //   dotnet run scripts/mutate-behaviour.cs -- --set tests/AgentBaseline.Tests/Mutations/startup.json
  //
  // Three places are left out, each for a stated reason. The caret handler's null guard is the
  // compiler's: without it the build refuses CS8602 under warnings as errors, so a mutation there is
  // killed by the build rather than by a test. Its early return before a review exists cannot be removed
  // and still compile, the review being the pattern's own variable. And App — the platform lifetime
  // App.Run starts — is what no headless test can reach; a by-hand run judges it, and Program.Run takes
  // the review as a parameter so everything before that call is held here.
  "project": "tests/AgentBaseline.Tests/AgentBaseline.Tests.csproj",
  "tests": [
    "tests/AgentBaseline.Tests/StartupTests.cs",
    "tests/AgentBaseline.Tests/StandingLineTests.cs"
  ],
