<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- ⛔ Still no markup. Avalonia arrives at plan 00034's step 5 through the library, for the view
       ReviewSession drives, but the first .axaml under src makes AccessibilityCoverageTests'
       library-plus-demo equality false, which step 11 pays. ProjectShapeTests holds the tripwire
       that says so. -->

  <ItemGroup>
    <!-- Step 2's parse. A locator only — see Directory.Packages.props and MarkdownOutline. -->
    <PackageReference Include="Markdig" />
  </ItemGroup>

  <ItemGroup>
    <!-- Step 3's ingest decodes through PaneSource.FromBytes and probes through TextProbe rather than
         a second implementation of either: the text this tool parses is the text it hands the diff
         control at step 5, and two decoders would put the outline on different lines. -->
    <ProjectReference Include="../DiffView.Core/DiffView.Core.csproj" />
    <!-- Step 5's review drives the library's own SideBySideDiffView: decision 1 makes this tool an app
         that hosts the control, never a second control. -->
    <ProjectReference Include="../DiffView.Avalonia/DiffView.Avalonia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>AgentBaseline.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
