<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dv="using:Bennewitz.Ninja.DiffView.Avalonia"
        x:Class="Bennewitz.Ninja.DiffView.Demo.MainWindow"
        Title="DiffView Demo"
        Width="1100" Height="720"
        MinWidth="640" MinHeight="400">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File" AutomationProperties.Name="File menu">
        <MenuItem Header="Open _left…" Click="OnOpenLeft" AutomationProperties.Name="Open a file in the left pane" />
        <MenuItem Header="Open _right…" Click="OnOpenRight" AutomationProperties.Name="Open a file in the right pane" />
        <Separator />
        <MenuItem Header="_Save left" InputGesture="Ctrl+S" Click="OnSaveLeft"
                  AutomationProperties.Name="Write the left pane back to its file" />
        <MenuItem Header="Save _right" Click="OnSaveRight"
                  AutomationProperties.Name="Write the right pane back to its file" />
        <MenuItem Header="Re_vert left" Click="OnRevertLeft"
                  AutomationProperties.Name="Discard the left pane's edits" />
        <MenuItem Header="Revert r_ight" Click="OnRevertRight"
                  AutomationProperties.Name="Discard the right pane's edits" />
        <Separator />
        <MenuItem Header="E_xit" Click="OnExit" AutomationProperties.Name="Exit" />
      </MenuItem>
      <MenuItem Header="_View" AutomationProperties.Name="View menu">
        <MenuItem x:Name="VariantLight" Header="_Light" ToggleType="Radio" GroupName="variant"
                  Click="OnVariantLight" AutomationProperties.Name="Light theme variant" />
        <MenuItem x:Name="VariantDark" Header="_Dark" ToggleType="Radio" GroupName="variant"
                  Click="OnVariantDark" AutomationProperties.Name="Dark theme variant" />
        <MenuItem x:Name="VariantSystem" Header="_System" ToggleType="Radio" GroupName="variant"
                  Click="OnVariantSystem" AutomationProperties.Name="Follow the system theme variant" />
        <Separator />
        <MenuItem x:Name="ColourBlindPalette" Header="Colour-_blind palette" ToggleType="CheckBox"
                  Click="OnToggleColourBlindPalette" AutomationProperties.Name="Use the colour-blind-safe palette" />
        <Separator />
        <MenuItem x:Name="UnifiedView" Header="_Unified (inline) view" ToggleType="CheckBox"
                  Click="OnToggleUnifiedView" AutomationProperties.Name="Show the comparison unified in one pane" />
        <MenuItem x:Name="ShowMinimap" Header="Show overview _map" ToggleType="CheckBox" IsChecked="True"
                  Click="OnToggleShowMinimap" AutomationProperties.Name="Show the two-lane overview map beside the panes" />
        <MenuItem x:Name="MinimapOnLeft" Header="Overview map on the le_ft" ToggleType="CheckBox"
                  Click="OnToggleMinimapPlacement" AutomationProperties.Name="Dock the overview map outside the left pane instead of the right" />
        <Separator />
        <MenuItem Header="_Find…" InputGesture="Ctrl+F" Click="OnFind"
                  AutomationProperties.Name="Open the find bar" />
        <Separator />
        <MenuItem x:Name="EditLeft" Header="Edit left _pane" ToggleType="CheckBox"
                  Click="OnToggleEditLeft" AutomationProperties.Name="Let the left pane be typed into" />
        <MenuItem x:Name="EditRight" Header="Edit right pa_ne" ToggleType="CheckBox"
                  Click="OnToggleEditRight" AutomationProperties.Name="Let the right pane be typed into" />
        <MenuItem x:Name="CopyToLeft" Header="Copy to _left" Click="OnCopyToLeft"
                  AutomationProperties.Name="Copy the selection, or the current change block, onto the left side" />
        <MenuItem x:Name="CopyToRight" Header="Copy to _right" Click="OnCopyToRight"
                  AutomationProperties.Name="Copy the selection, or the current change block, onto the right side" />
        <Separator />
        <!-- A submenu, not four more rows: this menu already scrolls past its fold, and the
             accelerators below are written from the control's key map rather than typed here, so
             the rebind moves the labels as well as the keys. -->
        <MenuItem Header="_Key bindings" AutomationProperties.Name="Key bindings">
          <MenuItem x:Name="NextChange" Header="Ne_xt change" Click="OnNextChange"
                    AutomationProperties.Name="Move to the next change block" />
          <MenuItem x:Name="PreviousChange" Header="Previous chan_ge" Click="OnPreviousChange"
                    AutomationProperties.Name="Move to the previous change block" />
          <Separator />
          <MenuItem x:Name="RebindNavigation" Header="_Rebind these to Ctrl+Down / Ctrl+Up" ToggleType="CheckBox"
                    Click="OnToggleRebindNavigation"
                    AutomationProperties.Name="Move next and previous change off F7 onto Ctrl+Down and Ctrl+Up" />
        </MenuItem>
        <Separator />
        <MenuItem x:Name="IgnoreWhitespace" Header="Ignore _whitespace" ToggleType="CheckBox"
                  Click="OnToggleIgnoreWhitespace" AutomationProperties.Name="Ignore whitespace differences" />
        <MenuItem x:Name="IgnoreCase" Header="Ignore _case" ToggleType="CheckBox"
                  Click="OnToggleIgnoreCase" AutomationProperties.Name="Ignore case differences" />
        <MenuItem x:Name="SyncHorizontal" Header="Sync _horizontal scroll" ToggleType="CheckBox"
                  Click="OnToggleSyncHorizontal" AutomationProperties.Name="Couple horizontal scrolling of the panes" />
        <MenuItem x:Name="UseSyntax" Header="S_yntax highlighting" ToggleType="CheckBox" IsChecked="True"
                  Click="OnToggleSyntax" AutomationProperties.Name="Colour the panes from a grammar chosen by file extension" />
        <Separator />
        <MenuItem x:Name="ShowWhitespace" Header="Show w_hitespace" ToggleType="CheckBox"
                  Click="OnToggleShowWhitespace" AutomationProperties.Name="Draw spaces and tabs as glyphs" />
        <MenuItem x:Name="ShowLineEndings" Header="Show line _endings" ToggleType="CheckBox"
                  Click="OnToggleShowLineEndings" AutomationProperties.Name="Draw a glyph at the end of each line" />
        <MenuItem Header="_Tab width" AutomationProperties.Name="Tab width">
          <MenuItem x:Name="Tab2" Header="_2" ToggleType="Radio" GroupName="tab"
                    Click="OnTabWidth" Tag="2" AutomationProperties.Name="Tab width of two columns" />
          <MenuItem x:Name="Tab4" Header="_4" ToggleType="Radio" GroupName="tab" IsChecked="True"
                    Click="OnTabWidth" Tag="4" AutomationProperties.Name="Tab width of four columns" />
          <MenuItem x:Name="Tab8" Header="_8" ToggleType="Radio" GroupName="tab"
                    Click="OnTabWidth" Tag="8" AutomationProperties.Name="Tab width of eight columns" />
        </MenuItem>
        <MenuItem Header="Pane font si_ze" AutomationProperties.Name="Pane font size">
          <MenuItem x:Name="FontTheme" Header="_Theme" ToggleType="Radio" GroupName="panefont" IsChecked="True"
                    Click="OnPaneFontSize" AutomationProperties.Name="The font size the pane theme sets" />
          <MenuItem x:Name="Font16" Header="1_6" ToggleType="Radio" GroupName="panefont"
                    Click="OnPaneFontSize" Tag="16" AutomationProperties.Name="Pane font size of sixteen" />
          <MenuItem x:Name="Font20" Header="_20" ToggleType="Radio" GroupName="panefont"
                    Click="OnPaneFontSize" Tag="20" AutomationProperties.Name="Pane font size of twenty" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Debug" AutomationProperties.Name="Debug menu">
        <MenuItem Header="Show live _log (F12)" Click="OnToggleLiveLog" AutomationProperties.Name="Show live log window" />
        <MenuItem Header="Open logs _folder" Click="OnOpenLogsFolder" AutomationProperties.Name="Open logs folder" />
        <Separator />
        <MenuItem Header="_Throw on the UI thread" Click="OnThrowOnUiThread" AutomationProperties.Name="Throw a test exception on the UI thread" />
        <MenuItem Header="Throw in an _unobserved task" Click="OnThrowInUnobservedTask" AutomationProperties.Name="Throw a test exception in an unobserved task" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Bottom" Padding="8,4">
      <TextBlock x:Name="StatusText" FontSize="12" />
    </Border>

    <!-- Both views, one showing: only the one on screen carries the sources, so the other
         neither builds nor holds a model. -->
    <Panel>
      <dv:SideBySideDiffView x:Name="Diff" AutomationProperties.Name="Side-by-side diff" />
      <dv:InlineDiffView x:Name="Unified" IsVisible="False" AutomationProperties.Name="Unified diff" />
    </Panel>
  </DockPanel>
</Window>
