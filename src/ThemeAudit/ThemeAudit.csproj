<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>ThemeAudit</AssemblyName>
    <RollForward>Major</RollForward>
    <!-- Packed as a dotnet tool: `dotnet tool install Bennewitz.Ninja.ThemeAudit` → `theme-audit`. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>theme-audit</ToolCommandName>
    <PackageId>Bennewitz.Ninja.ThemeAudit</PackageId>
    <IsPackable>true</IsPackable>
    <Description>
      Finds the resource keys an Avalonia theme leaves undefined — the invisible-control
      cases — and the tokens that fall below a contrast floor, for any Avalonia project.
      Themes in, consumers in, findings out. No dependency on DiffView.
    </Description>
    <PackageTags>avalonia;theme;resources;accessibility;contrast;audit</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <!-- The reviewed mappings ship beside the executable, so a configuration can name one
         without a path ("mapping": "FluentToSemi") and override it with a path of its own. -->
    <None Include="Mappings/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>ThemeAudit.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
