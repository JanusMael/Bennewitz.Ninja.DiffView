<!--
    The control theme of DiffViewer, compiled as DiffViewerTheme (the x:Class below) and merged by
    the control into its own resources, so the structure never depends on a host include and the
    merge is trim-safe. It is SideBySideDiffView's template without the find bar: the headers, the
    banner, the panes with the connector gutter and the overview map, and the status strip. The
    headers and the strip carry their own themes, DiffPaneHeader.axaml and DiffStatusStrip.axaml,
    which each of them merges itself; nothing in the viewer's tree carries the find bar's. Every
    brush is a DiffView.* token from the host's DiffView.axaml include; no host theme key is
    referenced.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dv="using:Bennewitz.Ninja.DiffView"
                    x:Class="Bennewitz.Ninja.DiffView.DiffViewerTheme">

  <ControlTheme x:Key="{x:Type dv:DiffViewer}" TargetType="dv:DiffViewer">
    <Setter Property="Background" Value="{DynamicResource DiffView.PaneBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DiffView.PaneForegroundBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid RowDefinitions="Auto,Auto,*,Auto" Background="{TemplateBinding Background}">
          <!-- Column for column with PART_Panes below, so a header is always exactly as wide as
               its pane. The two end slots are the overview map's; whichever one it is not in has
               no width, and the middle spacer is the connector gutter's. -->
          <Grid Name="PART_Headers" ColumnDefinitions="Auto,*,16,*,Auto">
            <Border Name="PART_HeaderLeftSpacer" Background="{DynamicResource DiffView.HeaderBackgroundBrush}" />
            <dv:DiffPaneHeader Name="PART_LeftHeader" Grid.Column="1"
                               AutomationProperties.Name="{TemplateBinding LeftHeaderName}" />
            <Border Grid.Column="2" Background="{DynamicResource DiffView.HeaderBackgroundBrush}" />
            <dv:DiffPaneHeader Name="PART_RightHeader" Grid.Column="3"
                               AutomationProperties.Name="{TemplateBinding RightHeaderName}" />
            <Border Name="PART_HeaderRightSpacer" Grid.Column="4" Background="{DynamicResource DiffView.HeaderBackgroundBrush}" />
          </Grid>

          <Border Name="PART_Banner" Grid.Row="1" Padding="10,6">
            <DockPanel>
              <Button Name="PART_BannerAction"
                      DockPanel.Dock="Right"
                      Margin="12,0,0,0"
                      VerticalAlignment="Center"
                      Content="{TemplateBinding BannerActionText}"
                      IsVisible="{TemplateBinding BannerActionText, Converter={x:Static ObjectConverters.IsNotNull}}"
                      ToolTip.Tip="{TemplateBinding BannerActionText}"
                      AutomationProperties.Name="{TemplateBinding BannerActionText}" />
              <TextBlock Name="PART_BannerText"
                         Text="{TemplateBinding BannerMessage}"
                         TextWrapping="Wrap"
                         VerticalAlignment="Center" />
            </DockPanel>
          </Border>

          <!-- A map slot at each end. An Auto column with no child in it takes no width, so
               the unused one costs nothing and docking right is pixel for pixel what it was. -->
          <Grid Name="PART_Panes" Grid.Row="2" ColumnDefinitions="Auto,*,16,*,Auto">
            <dv:DiffPanePresenter Name="PART_LeftPane" Grid.Column="1" AutomationProperties.Name="{TemplateBinding LeftPaneName}" />
            <dv:ChangeConnectorGutter Name="PART_Gutter" Grid.Column="2" AutomationProperties.Name="{TemplateBinding GutterName}" />
            <dv:DiffPanePresenter Name="PART_RightPane" Grid.Column="3" AutomationProperties.Name="{TemplateBinding RightPaneName}" />
            <dv:DiffMinimap Name="PART_Minimap" Grid.Column="4" AutomationProperties.Name="{TemplateBinding MinimapName}" />
          </Grid>

          <dv:DiffStatusStrip Name="PART_StatusStrip" Grid.Row="3" AutomationProperties.Name="{TemplateBinding StatusStripName}" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:banner-none /template/ Border#PART_Banner">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:banner-error /template/ Border#PART_Banner">
      <Setter Property="Background" Value="{DynamicResource DiffView.StatusFailureBackgroundBrush}" />
    </Style>
    <Style Selector="^:banner-error /template/ TextBlock#PART_BannerText">
      <Setter Property="Foreground" Value="{DynamicResource DiffView.StatusFailureForegroundBrush}" />
    </Style>
    <Style Selector="^:banner-degraded /template/ Border#PART_Banner">
      <Setter Property="Background" Value="{DynamicResource DiffView.StatusWarningBackgroundBrush}" />
    </Style>
    <Style Selector="^:banner-degraded /template/ TextBlock#PART_BannerText">
      <Setter Property="Foreground" Value="{DynamicResource DiffView.StatusWarningForegroundBrush}" />
    </Style>
    <Style Selector="^:banner-identical /template/ Border#PART_Banner">
      <Setter Property="Background" Value="{DynamicResource DiffView.StatusSuccessBackgroundBrush}" />
    </Style>
    <Style Selector="^:banner-identical /template/ TextBlock#PART_BannerText">
      <Setter Property="Foreground" Value="{DynamicResource DiffView.StatusSuccessForegroundBrush}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
