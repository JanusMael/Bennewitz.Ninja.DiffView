<!--
    The control themes of SideBySideDiffView, DiffFindBar, DiffPaneHeader and DiffStatusStrip,
    compiled as SideBySideDiffViewTheme (the x:Class below) and merged by each control into its
    own resources, so the structure never depends on a host include and the merge is trim-safe.
    Every brush is a DiffView.* token from the host's DiffView.axaml include; no host theme key
    is referenced. Pills follow ClaudeForge's status-bar family: corner radius 10, padding 6,2,
    11 px text, each carrying its text as tooltip and automation name so nothing is colour alone.
    The Button controls are the host's own, themed by the host.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dv="using:Bennewitz.Ninja.DiffView"
                    x:Class="Bennewitz.Ninja.DiffView.SideBySideDiffViewTheme">

  <ControlTheme x:Key="{x:Type dv:SideBySideDiffView}" TargetType="dv:SideBySideDiffView">
    <Setter Property="Background" Value="{DynamicResource DiffView.PaneBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DiffView.PaneForegroundBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Background="{TemplateBinding Background}">
          <!-- Column for column with PART_Panes below, so a header is always exactly as wide as
               its pane. The two end slots are the overview map's; whichever one it is not in has
               no width, and the middle spacer is the connector gutter's. -->
          <Grid Name="PART_Headers" ColumnDefinitions="Auto,*,16,*,Auto">
            <Border Name="PART_HeaderLeftSpacer" Background="{DynamicResource DiffView.HeaderBackgroundBrush}" />
            <dv:DiffPaneHeader Name="PART_LeftHeader" Grid.Column="1" />
            <Border Grid.Column="2" Background="{DynamicResource DiffView.HeaderBackgroundBrush}" />
            <dv:DiffPaneHeader Name="PART_RightHeader" Grid.Column="3" />
            <Border Name="PART_HeaderRightSpacer" Grid.Column="4" Background="{DynamicResource DiffView.HeaderBackgroundBrush}" />
          </Grid>

          <Border Name="PART_Banner" Grid.Row="1" Padding="10,6">
            <DockPanel>
              <Button Name="PART_BannerAction"
                      DockPanel.Dock="Right"
                      Margin="12,0,0,0"
                      VerticalAlignment="Center"
                      Content="{TemplateBinding BannerActionText}"
                      IsVisible="{TemplateBinding BannerActionText, Converter={x:Static ObjectConverters.IsNotNull}}"
                      ToolTip.Tip="{TemplateBinding BannerActionText}"
                      AutomationProperties.Name="{TemplateBinding BannerActionText}" />
              <TextBlock Name="PART_BannerText"
                         Text="{TemplateBinding BannerMessage}"
                         TextWrapping="Wrap"
                         VerticalAlignment="Center" />
            </DockPanel>
          </Border>

          <!-- The find bar collapses when it is closed, so its Auto row takes no height. -->
          <dv:DiffFindBar Name="PART_FindBar" Grid.Row="2" IsVisible="False" />

          <!-- A map slot at each end. An Auto column with no child in it takes no width, so
               the unused one costs nothing and docking right is pixel for pixel what it was. -->
          <Grid Name="PART_Panes" Grid.Row="3" ColumnDefinitions="Auto,*,16,*,Auto">
            <dv:DiffPanePresenter Name="PART_LeftPane" Grid.Column="1" AutomationProperties.Name="{TemplateBinding LeftPaneName}" />
            <dv:ChangeConnectorGutter Name="PART_Gutter" Grid.Column="2" AutomationProperties.Name="{TemplateBinding GutterName}" />
            <dv:DiffPanePresenter Name="PART_RightPane" Grid.Column="3" AutomationProperties.Name="{TemplateBinding RightPaneName}" />
            <dv:DiffMinimap Name="PART_Minimap" Grid.Column="4" AutomationProperties.Name="{TemplateBinding MinimapName}" />
          </Grid>

          <dv:DiffStatusStrip Name="PART_StatusStrip" Grid.Row="4" AutomationProperties.Name="{TemplateBinding StatusStripName}" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:banner-none /template/ Border#PART_Banner">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:banner-error /template/ Border#PART_Banner">
      <Setter Property="Background" Value="{DynamicResource DiffView.StatusFailureBackgroundBrush}" />
    </Style>
    <Style Selector="^:banner-error /template/ TextBlock#PART_BannerText">
      <Setter Property="Foreground" Value="{DynamicResource DiffView.StatusFailureForegroundBrush}" />
    </Style>
    <Style Selector="^:banner-degraded /template/ Border#PART_Banner">
      <Setter Property="Background" Value="{DynamicResource DiffView.StatusWarningBackgroundBrush}" />
    </Style>
    <Style Selector="^:banner-degraded /template/ TextBlock#PART_BannerText">
      <Setter Property="Foreground" Value="{DynamicResource DiffView.StatusWarningForegroundBrush}" />
    </Style>
    <Style Selector="^:banner-identical /template/ Border#PART_Banner">
      <Setter Property="Background" Value="{DynamicResource DiffView.StatusSuccessBackgroundBrush}" />
    </Style>
    <Style Selector="^:banner-identical /template/ TextBlock#PART_BannerText">
      <Setter Property="Foreground" Value="{DynamicResource DiffView.StatusSuccessForegroundBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type dv:DiffFindBar}" TargetType="dv:DiffFindBar">
    <Setter Property="Background" Value="{DynamicResource DiffView.HeaderBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DiffView.HeaderForegroundBrush}" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
          <StackPanel Orientation="Vertical" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBox Name="PART_Query"
                       Width="220"
                       MinHeight="0"
                       Padding="6,2"
                       VerticalAlignment="Center"
                       PlaceholderText="{TemplateBinding QueryPlaceholder}"
                       ToolTip.Tip="{TemplateBinding QueryName}"
                       AutomationProperties.Name="{TemplateBinding QueryName}" />
              <ToggleButton Name="PART_MatchCase"
                            Content="{TemplateBinding MatchCaseText}"
                            Padding="6,2"
                            MinHeight="0"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            ToolTip.Tip="{TemplateBinding MatchCaseName}"
                            AutomationProperties.Name="{TemplateBinding MatchCaseName}" />
              <ToggleButton Name="PART_WholeWord"
                            Content="{TemplateBinding WholeWordText}"
                            Padding="6,2"
                            MinHeight="0"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            ToolTip.Tip="{TemplateBinding WholeWordName}"
                            AutomationProperties.Name="{TemplateBinding WholeWordName}" />
              <ToggleButton Name="PART_Regex"
                            Content="{TemplateBinding RegexText}"
                            Padding="6,2"
                            MinHeight="0"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            ToolTip.Tip="{TemplateBinding RegexName}"
                            AutomationProperties.Name="{TemplateBinding RegexName}" />
              <ToggleButton Name="PART_ChangedRowsOnly"
                            Content="{TemplateBinding ChangedRowsOnlyText}"
                            Padding="6,2"
                            MinHeight="0"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            ToolTip.Tip="{TemplateBinding ChangedRowsOnlyName}"
                            AutomationProperties.Name="{TemplateBinding ChangedRowsOnlyName}" />

              <!-- The scope segmented control: exactly one of the three is checked. A host with
                   one pane hides the whole group, separator included. -->
              <Border Width="1" Margin="2,3" Background="{DynamicResource DiffView.ConnectorBrush}"
                      IsVisible="{TemplateBinding ShowScope}" />
              <ToggleButton Name="PART_ScopeLeft"
                            IsVisible="{TemplateBinding ShowScope}"
                            Content="{TemplateBinding ScopeLeftText}"
                            Padding="6,2"
                            MinHeight="0"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            ToolTip.Tip="{TemplateBinding ScopeLeftName}"
                            AutomationProperties.Name="{TemplateBinding ScopeLeftName}" />
              <ToggleButton Name="PART_ScopeRight"
                            IsVisible="{TemplateBinding ShowScope}"
                            Content="{TemplateBinding ScopeRightText}"
                            Padding="6,2"
                            MinHeight="0"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            ToolTip.Tip="{TemplateBinding ScopeRightName}"
                            AutomationProperties.Name="{TemplateBinding ScopeRightName}" />
              <ToggleButton Name="PART_ScopeBoth"
                            IsVisible="{TemplateBinding ShowScope}"
                            Content="{TemplateBinding ScopeBothText}"
                            Padding="6,2"
                            MinHeight="0"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            ToolTip.Tip="{TemplateBinding ScopeBothName}"
                            AutomationProperties.Name="{TemplateBinding ScopeBothName}" />

              <TextBlock Name="PART_Count"
                         Text="{TemplateBinding CountText}"
                         Foreground="{DynamicResource DiffView.MutedForegroundBrush}"
                         IsVisible="{TemplateBinding CountText, Converter={x:Static ObjectConverters.IsNotNull}}"
                         VerticalAlignment="Center" />

              <Button Name="PART_Previous"
                      Content="{TemplateBinding PreviousText}"
                      Padding="6,2"
                      MinHeight="0"
                      MinWidth="0"
                      VerticalAlignment="Center"
                      ToolTip.Tip="{TemplateBinding PreviousName}"
                      AutomationProperties.Name="{TemplateBinding PreviousName}" />
              <Button Name="PART_Next"
                      Content="{TemplateBinding NextText}"
                      Padding="6,2"
                      MinHeight="0"
                      MinWidth="0"
                      VerticalAlignment="Center"
                      ToolTip.Tip="{TemplateBinding NextName}"
                      AutomationProperties.Name="{TemplateBinding NextName}" />
              <Button Name="PART_Close"
                      Content="{TemplateBinding CloseText}"
                      Padding="6,2"
                      MinHeight="0"
                      MinWidth="0"
                      VerticalAlignment="Center"
                      ToolTip.Tip="{TemplateBinding CloseName}"
                      AutomationProperties.Name="{TemplateBinding CloseName}" />
            </StackPanel>

            <!-- A bad pattern and a truncated result each say so in place, under the query. -->
            <TextBlock Name="PART_Error"
                       Text="{TemplateBinding ErrorText}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource DiffView.StatusFailureForegroundBrush}"
                       IsVisible="{TemplateBinding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Name="PART_Notice"
                       Text="{TemplateBinding NoticeText}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource DiffView.StatusWarningForegroundBrush}"
                       IsVisible="{TemplateBinding NoticeText, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type dv:DiffPaneHeader}" TargetType="dv:DiffPaneHeader">
    <Setter Property="Background" Value="{DynamicResource DiffView.HeaderBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DiffView.HeaderForegroundBrush}" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}">
          <Grid>
            <!-- The focus accent is an overlay on the header's bottom edge: collapsed it
                 measures nothing, so a pane taking focus moves no row and no pixel outside
                 the header itself. -->
            <Border Name="PART_FocusAccent"
                    Height="2"
                    VerticalAlignment="Bottom"
                    IsVisible="False"
                    Background="{DynamicResource DiffView.FocusAccentBrush}" />
            <Border Padding="{TemplateBinding Padding}">
              <DockPanel>
                <Border Name="PART_Badge"
                        DockPanel.Dock="Right"
                        Margin="8,0,0,0"
                        Padding="4,1"
                        CornerRadius="3"
                        VerticalAlignment="Center"
                        IsVisible="{TemplateBinding Badge, Converter={x:Static ObjectConverters.IsNotNull}}"
                        ToolTip.Tip="{TemplateBinding Badge}"
                        AutomationProperties.Name="{TemplateBinding Badge}">
                  <TextBlock Name="PART_BadgeText" Text="{TemplateBinding Badge}" FontSize="11" FontWeight="SemiBold" />
                </Border>
                <TextBlock Name="PART_Dirty"
                           DockPanel.Dock="Right"
                           Margin="8,0,0,0"
                           Text="{TemplateBinding DirtyMarker}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource DiffView.StatusWarningForegroundBrush}"
                           VerticalAlignment="Center"
                           IsVisible="{TemplateBinding DirtyMarker, Converter={x:Static ObjectConverters.IsNotNull}}"
                           ToolTip.Tip="{TemplateBinding DirtyMarker}"
                           AutomationProperties.Name="{TemplateBinding DirtyMarker}" />
                <TextBlock Name="PART_Detail"
                           DockPanel.Dock="Right"
                           Margin="8,0,0,0"
                           Text="{TemplateBinding Detail}"
                           Foreground="{DynamicResource DiffView.MutedForegroundBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Name="PART_Title"
                           Text="{TemplateBinding Title}"
                           Foreground="{TemplateBinding Foreground}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
              </DockPanel>
            </Border>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pane-focused /template/ Border#PART_FocusAccent">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="^:badge-success /template/ Border#PART_Badge">
      <Setter Property="Background" Value="{DynamicResource DiffView.StatusSuccessBackgroundBrush}" />
    </Style>
    <Style Selector="^:badge-success /template/ TextBlock#PART_BadgeText">
      <Setter Property="Foreground" Value="{DynamicResource DiffView.StatusSuccessForegroundBrush}" />
    </Style>
    <Style Selector="^:badge-warning /template/ Border#PART_Badge">
      <Setter Property="Background" Value="{DynamicResource DiffView.StatusWarningBackgroundBrush}" />
    </Style>
    <Style Selector="^:badge-warning /template/ TextBlock#PART_BadgeText">
      <Setter Property="Foreground" Value="{DynamicResource DiffView.StatusWarningForegroundBrush}" />
    </Style>
    <Style Selector="^:badge-failure /template/ Border#PART_Badge">
      <Setter Property="Background" Value="{DynamicResource DiffView.StatusFailureBackgroundBrush}" />
    </Style>
    <Style Selector="^:badge-failure /template/ TextBlock#PART_BadgeText">
      <Setter Property="Foreground" Value="{DynamicResource DiffView.StatusFailureForegroundBrush}" />
    </Style>
    <Style Selector="^:badge-active /template/ Border#PART_Badge">
      <Setter Property="Background" Value="{DynamicResource DiffView.StatusActiveBackgroundBrush}" />
    </Style>
    <Style Selector="^:badge-active /template/ TextBlock#PART_BadgeText">
      <Setter Property="Foreground" Value="{DynamicResource DiffView.StatusActiveForegroundBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type dv:DiffStatusStrip}" TargetType="dv:DiffStatusStrip">
    <Setter Property="Background" Value="{DynamicResource DiffView.StatusBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DiffView.StatusForegroundBrush}" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
          <DockPanel>
            <TextBlock Name="PART_Caret"
                       DockPanel.Dock="Right"
                       Margin="12,0,0,0"
                       Text="{TemplateBinding CaretText}"
                       Foreground="{DynamicResource DiffView.MutedForegroundBrush}"
                       IsVisible="{TemplateBinding CaretText, Converter={x:Static ObjectConverters.IsNotNull}}"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Name="PART_StatePill"
                      CornerRadius="10"
                      Padding="6,2"
                      VerticalAlignment="Center"
                      ToolTip.Tip="{TemplateBinding StateText}"
                      AutomationProperties.Name="{TemplateBinding StateText}">
                <TextBlock Name="PART_StateText" Text="{TemplateBinding StateText}" FontSize="11" />
              </Border>
              <TextBlock Name="PART_Stale"
                         Text="{TemplateBinding StaleText}"
                         Foreground="{DynamicResource DiffView.MutedForegroundBrush}"
                         IsVisible="{TemplateBinding IsStale}"
                         VerticalAlignment="Center" />
              <TextBlock Name="PART_Dirty"
                         Text="{TemplateBinding DirtyText}"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource DiffView.StatusWarningForegroundBrush}"
                         IsVisible="{TemplateBinding DirtyText, Converter={x:Static ObjectConverters.IsNotNull}}"
                         ToolTip.Tip="{TemplateBinding DirtyText}"
                         AutomationProperties.Name="{TemplateBinding DirtyText}"
                         VerticalAlignment="Center" />
              <ProgressBar Name="PART_Progress"
                           Width="80"
                           IsIndeterminate="True"
                           IsVisible="{TemplateBinding IsBuildingSlowly}"
                           ToolTip.Tip="{TemplateBinding ProgressName}"
                           AutomationProperties.Name="{TemplateBinding ProgressName}"
                           VerticalAlignment="Center" />
              <TextBlock Name="PART_Counts"
                         Text="{TemplateBinding CountsText}"
                         Foreground="{TemplateBinding Foreground}"
                         IsVisible="{TemplateBinding CountsText, Converter={x:Static ObjectConverters.IsNotNull}}"
                         VerticalAlignment="Center" />
              <TextBlock Name="PART_Changes"
                         Text="{TemplateBinding ChangesText}"
                         Foreground="{TemplateBinding Foreground}"
                         IsVisible="{TemplateBinding ChangesText, Converter={x:Static ObjectConverters.IsNotNull}}"
                         VerticalAlignment="Center" />
              <TextBlock Name="PART_BuildTime"
                         Text="{TemplateBinding BuildTimeText}"
                         Foreground="{DynamicResource DiffView.MutedForegroundBrush}"
                         IsVisible="{TemplateBinding BuildTimeText, Converter={x:Static ObjectConverters.IsNotNull}}"
                         VerticalAlignment="Center" />
              <TextBlock Name="PART_Options"
                         Text="{TemplateBinding OptionsText}"
                         Foreground="{DynamicResource DiffView.MutedForegroundBrush}"
                         IsVisible="{TemplateBinding OptionsText, Converter={x:Static ObjectConverters.IsNotNull}}"
                         VerticalAlignment="Center" />
              <TextBlock Name="PART_Find"
                         Text="{TemplateBinding FindText}"
                         Foreground="{TemplateBinding Foreground}"
                         IsVisible="{TemplateBinding FindText, Converter={x:Static ObjectConverters.IsNotNull}}"
                         VerticalAlignment="Center" />
              <Border Name="PART_Transient"
                      CornerRadius="10"
                      Padding="6,2"
                      VerticalAlignment="Center"
                      IsVisible="{TemplateBinding TransientText, Converter={x:Static ObjectConverters.IsNotNull}}"
                      ToolTip.Tip="{TemplateBinding TransientText}"
                      AutomationProperties.Name="{TemplateBinding TransientText}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Name="PART_TransientText" Text="{TemplateBinding TransientText}" FontSize="11" VerticalAlignment="Center" />
                  <Button Name="PART_Dismiss"
                          Content="×"
                          Padding="4,0"
                          MinHeight="0"
                          MinWidth="0"
                          FontSize="11"
                          Command="{TemplateBinding DismissCommand}"
                          IsVisible="{TemplateBinding IsTransientDismissible}"
                          ToolTip.Tip="{TemplateBinding DismissText}"
                          AutomationProperties.Name="{TemplateBinding DismissText}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </DockPanel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:state-empty /template/ Border#PART_StatePill">
      <Setter Property="Background" Value="{DynamicResource DiffView.HeaderBackgroundBrush}" />
    </Style>
    <Style Selector="^:state-empty /template/ TextBlock#PART_StateText">
      <Setter Property="Foreground" Value="{DynamicResource DiffView.MutedForegroundBrush}" />
    </Style>
    <Style Selector="^:state-building /template/ Border#PART_StatePill">
      <Setter Property="Background" Value="{DynamicResource DiffView.StatusActiveBackgroundBrush}" />
    </Style>
    <Style Selector="^:state-building /template/ TextBlock#PART_StateText">
      <Setter Property="Foreground" Value="{DynamicResource DiffView.StatusActiveForegroundBrush}" />
    </Style>
    <Style Selector="^:state-ready /template/ Border#PART_StatePill">
      <Setter Property="Background" Value="{DynamicResource DiffView.StatusSuccessBackgroundBrush}" />
    </Style>
    <Style Selector="^:state-ready /template/ TextBlock#PART_StateText">
      <Setter Property="Foreground" Value="{DynamicResource DiffView.StatusSuccessForegroundBrush}" />
    </Style>
    <Style Selector="^:state-degraded /template/ Border#PART_StatePill">
      <Setter Property="Background" Value="{DynamicResource DiffView.StatusWarningBackgroundBrush}" />
    </Style>
    <Style Selector="^:state-degraded /template/ TextBlock#PART_StateText">
      <Setter Property="Foreground" Value="{DynamicResource DiffView.StatusWarningForegroundBrush}" />
    </Style>
    <Style Selector="^:state-failed /template/ Border#PART_StatePill">
      <Setter Property="Background" Value="{DynamicResource DiffView.StatusFailureBackgroundBrush}" />
    </Style>
    <Style Selector="^:state-failed /template/ TextBlock#PART_StateText">
      <Setter Property="Foreground" Value="{DynamicResource DiffView.StatusFailureForegroundBrush}" />
    </Style>

    <Style Selector="^:transient-active /template/ Border#PART_Transient">
      <Setter Property="Background" Value="{DynamicResource DiffView.StatusActiveBackgroundBrush}" />
    </Style>
    <Style Selector="^:transient-active /template/ TextBlock#PART_TransientText">
      <Setter Property="Foreground" Value="{DynamicResource DiffView.StatusActiveForegroundBrush}" />
    </Style>
    <Style Selector="^:transient-success /template/ Border#PART_Transient">
      <Setter Property="Background" Value="{DynamicResource DiffView.StatusSuccessBackgroundBrush}" />
    </Style>
    <Style Selector="^:transient-success /template/ TextBlock#PART_TransientText">
      <Setter Property="Foreground" Value="{DynamicResource DiffView.StatusSuccessForegroundBrush}" />
    </Style>
    <Style Selector="^:transient-warning /template/ Border#PART_Transient">
      <Setter Property="Background" Value="{DynamicResource DiffView.StatusWarningBackgroundBrush}" />
    </Style>
    <Style Selector="^:transient-warning /template/ TextBlock#PART_TransientText">
      <Setter Property="Foreground" Value="{DynamicResource DiffView.StatusWarningForegroundBrush}" />
    </Style>
    <Style Selector="^:transient-failure /template/ Border#PART_Transient">
      <Setter Property="Background" Value="{DynamicResource DiffView.StatusFailureBackgroundBrush}" />
    </Style>
    <Style Selector="^:transient-failure /template/ TextBlock#PART_TransientText">
      <Setter Property="Foreground" Value="{DynamicResource DiffView.StatusFailureForegroundBrush}" />
    </Style>
    <Style Selector="^:transient-state /template/ TextBlock#PART_TransientText">
      <Setter Property="Foreground" Value="{DynamicResource DiffView.MutedForegroundBrush}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
