<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Side-by-side diff control for Avalonia 12, built on AvaloniaEdit.</Description>
    <IsPackable>true</IsPackable>
    <!-- Named rather than defaulted: PackageId falls back to AssemblyName, which would publish this
         as the unprefixed DiffView.Avalonia where every other package of this author's is
         Bennewitz.Ninja.*. The assembly stays unprefixed — that convention is about assemblies —
         and the package carries the prefix and the platform both. -->
    <PackageId>Bennewitz.Ninja.DiffView.Avalonia</PackageId>
    <PackageTags>avalonia;diff;diff-view;side-by-side;compare;avaloniaedit;control;text-diff</PackageTags>
    <!-- Deviates from the repository convention (Bennewitz.Ninja.<AssemblyName>) on purpose: a
         namespace segment named Avalonia shadows the framework's own root inside this assembly, so
         Avalonia.Media.Color resolves to Bennewitz.Ninja.DiffView.Avalonia.Media.Color and fails
         with CS0234. Plan 00017 measured it. The platform is carried by the assembly and package
         name, which is where a consumer looks for it. This also fixes the embedded resource's
         logical name, which DiffViewStrings reads back as a string literal. -->
    <RootNamespace>Bennewitz.Ninja.DiffView</RootNamespace>
    <!-- Public API is documented; a missing comment is a build error (CS1591 under warnings-as-errors). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Marked trimmable, with the trim analyzer on every build (plan 00004 in
         Bennewitz.Ninja.Templates). The mark is compiled in, and a consumer's TrimMode=partial
         publish trims only marked assemblies. The analyzer cannot see compiled XAML; the trim
         check's TrimMode=link publish of the demo is the ILLink pass that can. -->
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <!-- The neutral resource IS English, so no en satellite is ever probed for: a lookup under any
         en-* culture resolves in the main assembly. Localization/Strings.resx is generated from
         DiffViewStrings.EnglishDefaults by scripts/gen-strings.cs; the locale files beside it are
         authored translations. -->
    <NeutralLanguage>en</NeutralLanguage>
    <!-- The eight the library ships, named rather than left to discovery: a consumer publishing
         trimmed keeps exactly these satellites, and a locale added without a line here would be
         built and then silently dropped from the published output. Matches the set asserted by
         LocaleParityTests.The_shipped_locales_are_exactly_the_declared_set. -->
    <SatelliteResourceLanguages>en;de-DE;es-ES;fr-FR;ja-JP;ko-KR;pt-BR;ru-RU;zh-CN</SatelliteResourceLanguages>
    <!-- The readme IS the hosting guide, not a second consumer-facing document to keep in step with
         it. Plan 00018 left this unset for that reason and handed it to plan 00019. The value is the
         file's name *inside the package*, which is why it carries no directory. -->
    <PackageReadmeFile>hosting-diffview.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="AvaloniaEdit.TextMate" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- What actually carries the file. The guide lives outside this project directory, so the
         property alone packs nothing and dotnet pack fails on a readme it cannot find — the
         LayeredEditors.Avalonia.Diagnostics failure DECISIONS.md records. PackagePath="\" is the
         package root, which is where PackageReadmeFile looks. -->
    <None Include="$(RepoRoot)docs/hosting-diffview.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DiffView.Core/DiffView.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>DiffView.Avalonia.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
