<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Sibling feed holding packages built from the author's other repositories
         (LayeredEditors.Avalonia.Diagnostics from ClaudeForge) and this repository's
         own theme-audit tool. Populate it with scripts/pack-diagnostics.* — see README.md. -->
    <add key="local" value="../nuget-local" />
  </packageSources>

  <!-- Every package id resolves from exactly one source. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local">
      <package pattern="LayeredEditors.*" />
      <package pattern="Bennewitz.Ninja.ThemeAudit" />
    </packageSource>
  </packageSourceMapping>
</configuration>
