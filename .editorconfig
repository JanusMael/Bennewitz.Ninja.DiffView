root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{axaml,xaml,csproj,props,targets,slnx,json,yml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning
dotnet_sort_system_directives_first = true
# CodeQuality's BNCQ1001, a visible method that lets its caller leave the cancellation token out, is off by the
# package's default and on here, in every project and script: Brian's choice of 2026-11-11, open item 39.
dotnet_diagnostic.BNCQ1001.severity = warning
