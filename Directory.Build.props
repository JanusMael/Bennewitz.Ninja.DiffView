<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Absolute repository root for targets that shell out to scripts/. -->
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <!-- Namespace convention: Bennewitz.Ninja.<AssemblyName>; assembly names stay unprefixed. -->
    <RootNamespace>Bennewitz.Ninja.$(MSBuildProjectName)</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Bennewitz.Ninja.AutoVersioning source generator: version stamps computed at build time. -->
    <GenerateAutoVersionedAssemblyInfo>true</GenerateAutoVersionedAssemblyInfo>
    <AssemblyCompany>Bennewitz.Ninja</AssemblyCompany>
    <AssemblyProduct>DiffView</AssemblyProduct>
    <CopyrightHolder>Brian Bennewitz</CopyrightHolder>
    <CommitSha Condition="'$(CommitSha)' == ''">$(GITHUB_SHA)</CommitSha>
    <!-- AutoVersioning records the released version as assembly metadata; it does not set it. The
         package version comes from the release tag as /p:Version=, so this follows it and reads
         1.0.0 on a local build, which is what a local build is. -->
    <PublicVersion Condition="'$(PublicVersion)' == ''">$(Version)</PublicVersion>
  </PropertyGroup>

  <!-- Package metadata shared by every packable project. Without a licence expression a package is
       one nobody's compliance review passes; without Authors it packs as the assembly name; without
       a repository URL the nuspec carries a commit hash pointing at nothing. PackageTags are
       per-project and live in the csproj beside the Description. The repository is named for the
       package stem, not the product: two of this author's three published packages name their
       repository after the full package id. See Decisions; plan 00018 names the old URL and is
       frozen. -->
  <PropertyGroup>
    <Authors>Brian Bennewitz</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/JanusMael/Bennewitz.Ninja.DiffView</PackageProjectUrl>
    <RepositoryUrl>https://github.com/JanusMael/Bennewitz.Ninja.DiffView</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- PDB policy: portable in Debug for local source stepping; embedded in Release so the
       shipped binary carries its own symbols and nothing loose has to travel with it. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <!-- A received file is what a gate rejected, written beside what it disagrees with for review —
       Verify's frames, ReferenceAuditTests' compat dictionaries, the theme audit's report — and never
       a source. The Avalonia package's markup glob leaves out $(DefaultItemExcludes) as the SDK's own
       globs do, so this keeps a stray beside a theme from being compiled and embedded in any project
       here, and the library from packing it. ReceivedFileTests reads the glob back through MSBuild. -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/*.received.*</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bennewitz.Ninja.AutoVersioning"
                      PrivateAssets="all"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <!-- Microsoft.VisualStudio.Threading.Analyzers, for two rules alone, the maintainer's decision of
       2026-11-03: VSTHRD101, an async lambda given where a void delegate is expected, which makes it
       async void, and VSTHRD110, a task nobody awaits. The first ends the process on a throw and the
       second loses the failure, as Inspections' docs/exception-resilience.md measured. The other
       rules are about Visual Studio's JoinableTaskFactory, or style, and are off: measured on
       DiffView, they found 49 sites and no defect. Private: nothing a package ships carries it. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);VSTHRD001;VSTHRD002;VSTHRD003;VSTHRD004;VSTHRD010;VSTHRD011;VSTHRD012;VSTHRD013</NoWarn>
    <NoWarn>$(NoWarn);VSTHRD100;VSTHRD102;VSTHRD103;VSTHRD104;VSTHRD105;VSTHRD106;VSTHRD107;VSTHRD108;VSTHRD109</NoWarn>
    <NoWarn>$(NoWarn);VSTHRD111;VSTHRD112;VSTHRD113;VSTHRD114;VSTHRD115;VSTHRD116;VSTHRD117</NoWarn>
    <NoWarn>$(NoWarn);VSTHRD200;VSTHRD201;VSTHRD202</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers"
                      PrivateAssets="all"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>
</Project>
