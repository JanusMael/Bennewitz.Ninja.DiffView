{
  // A set pinned by the fixture pins file, with no marker in its tests, whose project is the one these tests
  // run in: what a moved pin owes it turns on what that project's restore resolves, which is there whenever
  // they run. Read by MutateBehaviourTests under --owed-by and --list only.
  "project": "tests/DiffView.Avalonia.Tests/DiffView.Avalonia.Tests.csproj",
  "tests": ["fixtures/mutations/declared-tests.txt"],
  "pins": "fixtures/mutations/pins.xml",
  "mutations": [
    {
      "name": "the one place changes",
      "file": "fixtures/mutations/subject.txt",
      "old": "The one place an edit applies.",
      "new": "Somewhere else.",
      "killer": "A_plain_fact"
    },
    {
      "name": "a change that should not matter",
      "file": "fixtures/mutations/subject.txt",
      "old": "Nothing compiles it",
      "new": "Nothing builds it",
      "expect": "green",
      "because": "the subject is read by no test"
    }
  ]
}
